{
  "name": "epics-tca",
  "version": "1.1.13",
  "description": "TypeScript realization of EPICS Channel Acceess Client Protocol",
  "main": "./lib/index.js",
  "scripts": {
    "test": "./node_modules/.bin/jest --verbose",
    "build": "mkdir lib/WebPack; webpack",
    "build-doc": "./node_modules/.bin/typedoc src --out doc"
  },
  "jest": {
    "rootDir": "./lib",
    "testMatch": [
      "<rootDir>/**/*.test.js"
    ],
    "testTimeout": 20000
  },
  "keywords": [
    "EPICS",
    "Channel Access",
    "control system",
    "Experimental Physics and Industrial Control System"
  ],
  "author": "Hao Hao <haoh@ornl.gov>",
  "license": "ISC",
  "dependencies": {
    "buffer": "^6.0.3",
    "bufferutil": "^4.0.7",
    "utf-8-validate": "^5.0.10",
    "ws": "^8.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^17.0.33",
    "@types/ws": "^8.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.26.11",
    "webpack": "^5.81.0",
    "webpack-cli": "^5.0.2"
  }
}
