{
  "name": "epics-tca",
  "version": "1.1.30",
  "description": "TypeScript realization of EPICS Channel Acceess Client Protocol",
  "main": "./lib/index.js",
  "scripts": {
    "test": "./node_modules/.bin/jest --verbose",
    "build": "mkdir lib/WebPack; webpack",
    "build-doc": "./node_modules/.bin/typedoc src --out doc"
  },
  "jest": {
    "rootDir": "./lib",
    "testMatch": [
      "<rootDir>/**/*.test.js"
    ],
    "testTimeout": 20000
  },
  "keywords": [
    "EPICS",
    "Channel Access",
    "control system",
    "Experimental Physics and Industrial Control System"
  ],
  "author": "Hao Hao <haoh@ornl.gov>",
  "license": "ISC",
  "dependencies": {
    "buffer": "^6.0.3",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.12",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
